{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "default_agent": "build",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local (4k)",
          "limit": { "context": 4096, "output": 512 }
        }
      }
    },
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  }
  ,
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./practices/practice_03/lab/demo/repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
