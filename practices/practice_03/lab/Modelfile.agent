FROM qwen3.5:4b
# Агентная конфигурация для OpenCode.
# ВНИМАНИЕ: фактический предел контекста задаётся сборкой модели.
# На Windows/CPU большие значения num_ctx могут вызывать сбои.
# Используем безопасное значение по умолчанию.
# Для ускорения снижаем контекст: меньше аллокаций и быстрее KV‑кэш на CPU.
PARAMETER num_ctx 4096
PARAMETER num_predict 512
PARAMETER temperature 0.2

